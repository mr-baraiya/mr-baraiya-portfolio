# Express Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas / Local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/portfolio_db

# Frontend Application URL (for CORS authorization & Password Reset links)
CLIENT_URL=http://localhost:5173

# Admin JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# SMTP Nodemailer Email Service Credentials (for Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com
